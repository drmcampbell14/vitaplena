{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0,
    "baseUrl": "."
  },
  "include": ["src/**/*.js", "netlify/functions/**/*.mjs", "test/**/*.js", "types/*.d.ts"],
  "exclude": ["node_modules", "dist"]
}
